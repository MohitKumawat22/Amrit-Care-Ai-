# ==========================================
# AmritCare AI Environment Variables
# ==========================================

# Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication (NextAuth & JWT)
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# AI Engines
GROQ_API_KEY=your_groq_api_key                       # Groq API key for AI Chatbot & Triage
GROK_API_KEY=your_xai_grok_api_key                   # x.ai Grok key for AI call worker greeting

# Telephony (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
NGROK_URL=https://your-ngrok-domain.ngrok-free.dev

# Maps / Places
MAPPLS_API_KEY=your_mappls_api_key                   # Mappls / MapMyIndia API key

# Voice / Avatar (Optional)
NEXT_PUBLIC_DEEPGRAM_API_KEY=your_deepgram_api_key   # Deepgram TTS for 3D Doctor Avatar

# ==========================================
# Automation & External Feeds (n8n & APILayer)
# ==========================================

# n8n Outbound Webhooks (Triggered on events)
N8N_REMINDER_WEBHOOK_URL=
N8N_ALERT_WEBHOOK_URL=
N8N_MISSED_DOSE_WEBHOOK_URL=

# n8n Inbound Webhook Shared Secret (for /api/n8n/callback)
N8N_CALLBACK_SECRET=your_secure_n8n_secret_token_here

# APILayer Integration (Weather & Medicine lookup)
APILAYER_API_KEY=your_apilayer_api_key
